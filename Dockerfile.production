FROM node:lts-alpine AS base

ENV PNPM_HOME=/usr/local/bin

# Build stage
FROM base AS build
WORKDIR /app

RUN apk add --no-cache --virtual .gyp python3 make g++
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package*.json ./
COPY pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile || npm install --production
RUN (pnpm install --global @nestjs/cli && pnpm install --save-dev @types/node) \
|| (npm install --global @nestjs/cli && npm install --save-dev @types/node)

COPY . .

RUN npx prisma generate
RUN pnpm run build || npm run build

RUN pnpm prune || npm prune

USER node

# Production stage 
FROM base AS production
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

ENV NODE_ENV=production

ARG BACKEND_PORT
ARG CORS_ALLOWED_ORIGINS
ARG CLIENT_URI
ARG SERVER_URI
ARG DATABASE_TYPE
ARG DATABASE_HOST
ARG DATABASE_USERNAME
ARG DATABASE_PASSWORD
ARG DATABASE_NAME
ARG DATABASE_PORT
ARG DATABASE_URL
ARG SUPABASE_URL
ARG SUPABASE_KEY
ARG SUPABASE_BUCKET_NAME
ARG SUPABASE_JWT_SECRET
ARG COOKIE_ACCESS_TOKEN_NAME
ARG COOKIE_REFRESH_TOKEN_NAME
ARG COOKIE_OAUTH2_TOKEN_NAME
ARG COOKIE_ACCOUNT_COMPLETION_TOKEN_NAME
ARG COOKIE_DOMAIN
ARG COOKIE_SECRET
ARG JWT_SECRET
ARG JWT_ACCESS_TOKEN_DURATION
ARG JWT_REFRESH_TOKEN_DURATION
ARG JWT_REFRESH_TOKEN_EXTENDED_DURATION
ARG JWT_OAUTH2_TOKEN_DURATION
ARG JWT_ACCOUNT_COMPLETION_TOKEN_DURATION
ARG JWT_ISSUER
ARG JWT_AUDIENCE
ARG USER_PASSWORD_SALT_PREFIX
ARG USER_PASSWORD_SALT_SUFFIX
ARG USER_PASSWORD_SALT_ROUNDS
ARG DEFAULT_LOG_LEVEL
ARG STRIPE_PUBLISHABLE_KEY
ARG STRIPE_SECRET_KEY
ARG STRIPE_DEFAULT_CURRENCY
ARG REDIS_HOST
ARG REDIS_PORT
ARG REDIS_USERNAME
ARG REDIS_PASSWORD
ARG REDIS_TLS_ENABLED
ARG REDIS_TLS_CA
ARG REDIS_TLS_KEY
ARG REDIS_TLS_CERT
ARG GOOGLE_CLIENT_ID
ARG GOOGLE_CLIENT_SECRET
ARG DISCORD_CLIENT_ID
ARG DISCORD_CLIENT_SECRET
ARG AUTH_MESSAGE_TEMPLATE

ENV BACKEND_PORT=${BACKEND_PORT}
ENV CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS}
ENV CLIENT_URI=${CLIENT_URI}
ENV SERVER_URI=${SERVER_URI}
ENV DATABASE_TYPE=${DATABASE_TYPE}
ENV DATABASE_HOST=${DATABASE_HOST}
ENV DATABASE_USERNAME=${DATABASE_USERNAME}
ENV DATABASE_PASSWORD=${DATABASE_PASSWORD}
ENV DATABASE_NAME=${DATABASE_NAME}
ENV DATABASE_PORT=${DATABASE_PORT}
ENV DATABASE_URL=${DATABASE_URL}
ENV SUPABASE_URL=${SUPABASE_URL}
ENV SUPABASE_KEY=${SUPABASE_KEY}
ENV SUPABASE_BUCKET_NAME=${SUPABASE_BUCKET_NAME}
ENV SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
ENV COOKIE_ACCESS_TOKEN_NAME=${COOKIE_ACCESS_TOKEN_NAME}
ENV COOKIE_REFRESH_TOKEN_NAME=${COOKIE_REFRESH_TOKEN_NAME}
ENV COOKIE_OAUTH2_TOKEN_NAME=${COOKIE_OAUTH2_TOKEN_NAME}
ENV COOKIE_ACCOUNT_COMPLETION_TOKEN_NAME=${COOKIE_ACCOUNT_COMPLETION_TOKEN_NAME}
ENV COOKIE_DOMAIN=${COOKIE_DOMAIN}
ENV COOKIE_SECRET=${COOKIE_SECRET}
ENV JWT_SECRET=${JWT_SECRET}
ENV JWT_ACCESS_TOKEN_DURATION=${JWT_ACCESS_TOKEN_DURATION}
ENV JWT_REFRESH_TOKEN_DURATION=${JWT_REFRESH_TOKEN_DURATION}
ENV JWT_REFRESH_TOKEN_EXTENDED_DURATION=${JWT_REFRESH_TOKEN_EXTENDED_DURATION}
ENV JWT_OAUTH2_TOKEN_DURATION=${JWT_OAUTH2_TOKEN_DURATION}
ENV JWT_ACCOUNT_COMPLETION_TOKEN_DURATION=${JWT_ACCOUNT_COMPLETION_TOKEN_DURATION}
ENV JWT_ISSUER=${JWT_ISSUER}
ENV JWT_AUDIENCE=${JWT_AUDIENCE}
ENV USER_PASSWORD_SALT_PREFIX=${USER_PASSWORD_SALT_PREFIX}
ENV USER_PASSWORD_SALT_SUFFIX=${USER_PASSWORD_SALT_SUFFIX}
ENV USER_PASSWORD_SALT_ROUNDS=${USER_PASSWORD_SALT_ROUNDS}
ENV DEFAULT_LOG_LEVEL=${DEFAULT_LOG_LEVEL}
ENV STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
ENV STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
ENV STRIPE_DEFAULT_CURRENCY=${STRIPE_DEFAULT_CURRENCY}
ENV REDIS_HOST=${REDIS_HOST}
ENV REDIS_PORT=${REDIS_PORT}
ENV REDIS_USERNAME=${REDIS_USERNAME}
ENV REDIS_PASSWORD=${REDIS_PASSWORD}
ENV REDIS_TLS_ENABLED=${REDIS_TLS_ENABLED}
ENV REDIS_TLS_CA=${REDIS_TLS_CA}
ENV REDIS_TLS_KEY=${REDIS_TLS_KEY}
ENV REDIS_TLS_CERT=${REDIS_TLS_CERT}
ENV GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
ENV GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
ENV DISCORD_CLIENT_ID=${DISCORD_CLIENT_ID}
ENV DISCORD_CLIENT_SECRET=${DISCORD_CLIENT_SECRET}
ENV AUTH_MESSAGE_TEMPLATE=${AUTH_MESSAGE_TEMPLATE}

COPY --chown=node:node --from=build /app/package.json /app/pnpm-lock.yaml ./
COPY --chown=node:node --from=build /app/node_modules ./node_modules
COPY --chown=node:node --from=build /app/dist ./dist
COPY --chown=node:node --from=build /app/prisma ./prisma

CMD ["sh", "-c", "NODE_OPTIONS='--max-old-space-size=2048' node dist/main.js"]

EXPOSE 8000