// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl", "linux-debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRegistrationMethods {
  Credentials
  Google
  Discord
  SolanaWallet
}

enum PostReactions {
  Like
  Dislike
  Laugh
  Anger
  Heart
  Crying
}

enum PostCommentReactions {
  Like
  Dislike
  Laugh
  Anger
  Heart
  Crying
}

enum ChatMessageReactions {
  Like
  Dislike
  Laugh
  Anger
  Heart
  Crying
}

enum ChatMessageStatuses {
  Sent
  Read
}

enum UserReportReasons {
  Spam
  Cheating
  Herrasment
  Impersonation
  InappropriateProfile
  Other
}

enum PostReportReasons {
  Spam
  Cheating
  HateSpeach
  InappropriateContent
  Violence
  Copyright
  Other
}

enum PostCommentReportReasons {
  Spam
  HateSpeach
  InappropriateContent
  Herrasment
  Other
}

enum UserReportStatuses {
  OnReview
  AppliedPenalties
  NoViolationsFound
}

enum PostReportStatuses {
  OnReview
  AppliedPenalties
  NoViolationsFound
}

enum PostCommentReportStatuses {
  OnReview
  AppliedPenalties
  NoViolationsFound
}

enum ChatTypes {
  Private
  Group
  Supergroup
  Channel
}

enum UserRoles {
  User
  Volunteer
  Administrator
}

enum ChatRoles {
  User
  Moderator
  Administrator
}

model UserRole {
  name        UserRoles @id
  permissions BigInt    @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  users User[]

  @@index([name, permissions])
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  userRegistrationMethod UserRegistrationMethods @default(Credentials)
  role                   UserRoles               @default(User)
  firstName              String                  @db.VarChar(50)
  lastName               String                  @db.VarChar(50)
  birthDate              DateTime                @db.Timestamptz
  email                  String                  @unique @db.VarChar(50)
  password               String?                 @db.Text
  phone                  String?                 @db.VarChar(15)
  bio                    String?                 @db.Text
  image                  String?                 @db.Text
  walletPublicKey        String?                 @unique @db.VarChar(255)
  refreshToken           String?                 @db.Text
  stripeCustomerId       String                  @db.VarChar(255)
  createdAt              DateTime                @default(now()) @db.Timestamptz
  updatedAt              DateTime                @updatedAt @db.Timestamptz

  userRole                    UserRole              @relation(fields: [role], references: [name], onDelete: NoAction, onUpdate: Cascade)
  followings                  Following[]           @relation("FollowerUser")
  followers                   Following[]           @relation("FollowedUser")
  userReports                 UserReport[]          @relation("ReportedUser")
  outcomingUserReports        UserReport[]          @relation("ReporterUserToUser")
  outcomingPostReports        PostReport[]          @relation("ReporterUserToPost")
  outcomingPostCommentReports PostCommentReport[]   @relation("ReporterUserToPostComment")
  userPenalties               UserPenalty[]
  chatsToUsers                ChatToUser[]
  messages                    ChatMessage[]
  chatMessageReactions        ChatMessageReaction[]
  posts                       Post[]
  postReactions               PostReaction[]
  postComments                PostComment[]
  postCommentReactions        PostCommentReaction[]

  @@index([email, walletPublicKey, role, stripeCustomerId, userRegistrationMethod])
}

model UserPenalty {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  dueTo              DateTime? @db.Timestamptz
  note               String    @db.Text
  permissionsPenalty BigInt    @db.BigInt
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, dueTo, createdAt, updatedAt])
}

model UserReport {
  id         String             @id @default(uuid()) @db.Uuid
  reporterId String             @db.Uuid
  userId     String             @db.Uuid
  reason     UserReportReasons
  status     UserReportStatuses @default(OnReview)
  note       String?            @db.Text
  createdAt  DateTime           @default(now()) @db.Timestamptz
  updatedAt  DateTime           @updatedAt @db.Timestamptz

  reporter User @relation("ReporterUserToUser", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user     User @relation("ReportedUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reporterId, userId, reason])
}

model Following {
  userId     String   @db.Uuid
  followerId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user     User @relation("FollowedUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  follower User @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id(fields: [userId, followerId])
  @@index([userId, followerId])
}

model Chat {
  id          String    @id @default(uuid()) @db.Uuid
  name        String?   @db.VarChar(255)
  type        ChatTypes @default(Private)
  image       String?   @db.Text
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  chatsToUsers ChatToUser[]
  messages     ChatMessage[]

  @@index([name])
}

model ChatRole {
  name        ChatRoles @id
  permissions BigInt    @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  chatsToUsers ChatToUser[]

  @@index([name, permissions])
}

model ChatMessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  location  String   @db.Text
  filename  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([messageId])
}

model ChatMessage {
  id              String              @id @default(uuid()) @db.Uuid
  chatId          String              @db.Uuid
  authorId        String              @db.Uuid
  parentMessageId String?             @db.Uuid
  content         String              @db.Text
  isPinned        Boolean             @default(false) @db.Boolean
  status          ChatMessageStatuses @default(Sent)
  createdAt       DateTime            @default(now()) @db.Timestamptz
  updatedAt       DateTime            @updatedAt @db.Timestamptz
  removedAt       DateTime?           @db.Timestamptz

  chat          Chat                    @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author        User                    @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentMessage ChatMessage?            @relation("ParentMessage", fields: [parentMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies       ChatMessage[]           @relation("ParentMessage")
  attachments   ChatMessageAttachment[]
  reactions     ChatMessageReaction[]

  @@index([chatId, authorId, isPinned, createdAt])
}

model ChatMessageReaction {
  messageId String               @db.Uuid
  userId    String               @db.Uuid
  reaction  ChatMessageReactions
  createdAt DateTime             @default(now()) @db.Timestamptz
  updatedAt DateTime             @updatedAt @db.Timestamptz

  chatMessage ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([messageId, userId])
  @@index([messageId, userId, reaction])
}

model ChatToUser {
  chatId                   String    @db.Uuid
  userId                   String    @db.Uuid
  role                     ChatRoles @default(User)
  isArchived               Boolean   @default(false) @db.Boolean
  lastSeenMessageTimestamp DateTime  @default(now()) @db.Timestamptz
  createdAt                DateTime  @default(now()) @db.Timestamptz
  updatedAt                DateTime  @updatedAt @db.Timestamptz

  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chatRole ChatRole @relation(fields: [role], references: [name], onDelete: NoAction, onUpdate: Cascade)

  @@id([chatId, userId])
  @@index([chatId, userId, lastSeenMessageTimestamp])
}

model Post {
  id              String    @id @default(uuid()) @db.Uuid
  authorId        String    @db.Uuid
  title           String    @db.VarChar(255)
  content         String    @db.Text
  fundsToBeRaised Decimal   @db.Money
  deadline        DateTime? @db.Timestamptz
  image           String?   @db.Text
  isDraft         Boolean   @default(false) @db.Boolean
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  removedAt       DateTime? @db.Timestamptz

  author            User             @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reports           PostReport[]     @relation("ReportedPost")
  categoriesToPosts CategoryToPost[]
  donations         PostDonation[]
  reactions         PostReaction[]
  comments          PostComment[]
  attachments       PostAttachment[]

  @@index([authorId, title, isDraft])
}

model PostReport {
  id         String             @id @default(uuid()) @db.Uuid
  reporterId String             @db.Uuid
  postId     String             @db.Uuid
  reason     PostReportReasons
  status     PostReportStatuses @default(OnReview)
  note       String?            @db.Text
  createdAt  DateTime           @default(now()) @db.Timestamptz
  updatedAt  DateTime           @updatedAt @db.Timestamptz

  reporter User @relation("ReporterUserToPost", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post     Post @relation("ReportedPost", fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reporterId, postId, reason])
}

model PostCategory {
  name      String   @id @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  categoriesToPosts CategoryToPost[]

  @@index([name])
}

model PostAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  location  String   @db.Text
  filename  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([postId])
}

model PostDonation {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  details   Json     @default("{}") @db.Json
  amount    Decimal  @db.Money
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([postId, amount])
}

model PostReaction {
  userId    String        @db.Uuid
  postId    String        @db.Uuid
  reaction  PostReactions
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, postId])
  @@index([userId, postId, reaction])
}

model PostComment {
  id              String    @id @default(uuid()) @db.Uuid
  postId          String    @db.Uuid
  authorId        String    @db.Uuid
  parentCommentId String?   @db.Uuid
  content         String    @db.Text
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  removedAt       DateTime? @db.Timestamptz

  post          Post                    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author        User                    @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentComment PostComment?            @relation("ParentComment", fields: [parentCommentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replies       PostComment[]           @relation("ParentComment")
  reports       PostCommentReport[]     @relation("ReportedPostComment")
  reactions     PostCommentReaction[]
  attachments   PostCommentAttachment[]

  @@index([postId, authorId, parentCommentId])
}

model PostCommentReport {
  id            String                    @id @default(uuid()) @db.Uuid
  reporterId    String                    @db.Uuid
  postCommentId String                    @db.Uuid
  reason        PostCommentReportReasons
  status        PostCommentReportStatuses @default(OnReview)
  note          String?                   @db.Text
  createdAt     DateTime                  @default(now()) @db.Timestamptz
  updatedAt     DateTime                  @updatedAt @db.Timestamptz

  reporter    User        @relation("ReporterUserToPostComment", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postComment PostComment @relation("ReportedPostComment", fields: [postCommentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([reporterId, postCommentId, reason])
}

model PostCommentReaction {
  commentId String               @db.Uuid
  userId    String               @db.Uuid
  reaction  PostCommentReactions
  createdAt DateTime             @default(now()) @db.Timestamptz
  updatedAt DateTime             @updatedAt @db.Timestamptz

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([commentId, userId])
  @@index([commentId, userId, reaction])
}

model PostCommentAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @db.Uuid
  location  String   @db.Text
  filename  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([commentId])
}

model CategoryToPost {
  postId    String   @db.Uuid
  category  String   @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postCategory PostCategory @relation(fields: [category], references: [name], onDelete: NoAction, onUpdate: Cascade)

  @@id([postId, category])
  @@index([postId, category])
}
